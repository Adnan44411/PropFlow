# ─────────────────────────────────────────────────────────────────────────────
# PropFlow — every setting both services read. Copy to .env (git-ignored).
# Secrets: generate with `npm run keys:generate` and paste; NEVER commit real values.
# Railway: set these as service variables (reference MySQL/Redis plugin vars).
# ─────────────────────────────────────────────────────────────────────────────

# ── docker compose only ──
MYSQL_ROOT_PASSWORD=change-me-root
AUTH_DB_PASSWORD=change-me-auth
CRM_DB_PASSWORD=change-me-crm

# ── shared ──
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=1
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=
WEB_ORIGIN=http://localhost:5173              # comma-separated list allowed; CORS + socket + cookie Origin check
JWT_ISSUER=propflow-auth
JWT_AUDIENCE=propflow

# ── auth-server (apps/auth-server) ──
PORT=4000
DATABASE_URL=mysql://auth:change-me-auth@127.0.0.1:3306/auth_db
# JWT_PRIVATE_KEY=<base64 PEM>                  # appended by: npm run -s keys:generate >> .env
# KEY_ENCRYPTION_KEY=<32 bytes base64>          # (same command) encrypts rotated private keys at rest
ACCESS_TOKEN_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=604800
INVITE_TTL_SECONDS=86400
RETIRED_KEY_GRACE_SECONDS=86700
KEY_RELOAD_INTERVAL_MS=30000
WEB_URL=http://localhost:5173                  # used to build invite links
COOKIE_NAME=pf_rt
COOKIE_SECURE=true                             # false only for plain-http localhost
COOKIE_SAMESITE=none                           # web.app ↔ railway.app are different sites
COOKIE_DOMAIN=
COOKIE_PATH=/auth
BCRYPT_ROUNDS=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
SEED_PASSWORD=PropFlow@123                     # demo logins (documented in README)

# ── crm-api (apps/crm-api) — PORT/DATABASE_URL differ per service ──
# PORT=4001
# DATABASE_URL=mysql://crm:change-me-crm@127.0.0.1:3306/crm_db
AUTH_SERVER_URL=http://127.0.0.1:4000
AUTH_JWKS_URL=                                 # default: $AUTH_SERVER_URL/.well-known/jwks.json
JWKS_CACHE_SECONDS=600
JWKS_MIN_REFETCH_MS=5000
INSTANCE_ID=                                   # default: hostname-pid
CRON_ENABLED=true
CRON_TZ=Asia/Kolkata
REMINDER_LEAD_MINUTES=15
STALE_AFTER_DAYS=30
EXPORT_BATCH_SIZE=1000
DASHBOARD_CACHE_SECONDS=60
MASTER_DATA_CACHE_SECONDS=3600
SOCKET_PING_INTERVAL_MS=20000

# ── tests (npm test) ──
TEST_AUTH_DATABASE_URL=mysql://root:change-me-root@127.0.0.1:3306/auth_test
TEST_CRM_DATABASE_URL=mysql://root:change-me-root@127.0.0.1:3306/crm_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15
