{
  "name": "@propflow/crm-api",
  "version": "1.0.0",
  "private": true,
  "description": "PropFlow CRM API: properties, site visits, chat, master data, dashboard, export",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/scripts/migrate.ts up",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "migrate:prod": "node dist/src/scripts/migrate.js up",
    "seed": "tsx seeders/seed.ts",
    "seed:prod": "node dist/seeders/seed.js",
    "explain": "tsx src/scripts/explain.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@propflow/shared": "1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "node-cron": "^3.0.3",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
