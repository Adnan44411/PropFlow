{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "apps/auth-server/Dockerfile", "watchPatterns": ["apps/auth-server/**", "packages/shared/**", "package-lock.json"] },
  "deploy": {
    "preDeployCommand": ["node dist/src/scripts/migrate.js up"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 10
  }
}
